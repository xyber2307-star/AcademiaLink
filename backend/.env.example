# ==============================================================================
# AcademiaLINK Backend Environment Configuration Template
# ==============================================================================
# Duplicate this file to '.env' in the backend/ directory and configure credentials.

# --- Firebase Admin SDK Authentication ---
# Option 1: Path to Firebase Service Account JSON file (RECOMMENDED FOR LOCAL DEV)
FIREBASE_CREDENTIALS_PATH=service_account.json

# Option 2: Individual Service Account Fields (RECOMMENDED FOR PRODUCTION / DOCKER / CI)
FIREBASE_PROJECT_ID=academialink-b10b3
# FIREBASE_PRIVATE_KEY_ID=your_private_key_id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@academialink-b10b3.iam.gserviceaccount.com
# FIREBASE_CLIENT_ID=your_client_id
# FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# Option 3: Full Service Account JSON String (ALTERNATIVE FOR CLOUD HOSTING)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type": "service_account", ...}

# --- Firestore Database ---
# Set database ID if using a named database (e.g. academia), or leave as '(default)'
FIRESTORE_DATABASE_ID=academia

# --- Server & Networking Configuration ---
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ENVIRONMENT=development

# --- AI & External Integration Services (Optional) ---
# Google Gemini API Key for AI Career Assistant (if real-time LLM inference is enabled)
# GEMINI_API_KEY=your-gemini-api-key

# Firebase Web Client API Key (optional, used for running end-to-end integration tests)
# FIREBASE_WEB_API_KEY=your-firebase-web-api-key
