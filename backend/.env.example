# ==============================================================================
# AcademiaLINK Backend Environment Configuration Template
# ==============================================================================
# Duplicate this file to '.env' in the backend/ directory and configure credentials.

# --- Firebase Admin SDK Authentication ---
# Option 1: Path to Firebase Service Account JSON file (RECOMMENDED FOR LOCAL DEV)
FIREBASE_CREDENTIALS_PATH=service_account.json

# Option 2: Individual Service Account Fields (RECOMMENDED FOR PRODUCTION / DOCKER / CI)
FIREBASE_PROJECT_ID=academialink-b10b3
# FIREBASE_PRIVATE_KEY_ID=your_private_key_id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@academialink-b10b3.iam.gserviceaccount.com
# FIREBASE_CLIENT_ID=your_client_id
# FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# Option 3: Full Service Account JSON String (ALTERNATIVE FOR CLOUD HOSTING)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type": "service_account", ...}

# --- Firestore Database ---
# Set database ID if using a named database (e.g. academia), or leave as '(default)'
FIRESTORE_DATABASE_ID=academia

# --- Server & Networking Configuration ---
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ENVIRONMENT=development

# --- AI & External Integration Services (Optional) ---
# Google Gemini API Key for AI Career Assistant (if real-time LLM inference is enabled)
# GEMINI_API_KEY=your-gemini-api-key

# Firebase Web Client API Key (optional, used for running end-to-end integration tests)
# FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Adzuna Jobs API (https://developer.adzuna.com/) - real live job postings for Job Market Intelligence.
# Get your own app_id/app_key at https://developer.adzuna.com/signup
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key
# ADZUNA_COUNTRY=in
# ADZUNA_SEARCH_QUERY=software engineer
# ADZUNA_MAX_PAGES=3

# --- Optional: AWS-backed Job Market Data Feed (alternative/supplementary source) ---
# AWS_MARKET_DATA_ENDPOINT=https://your-api-gateway-url
# AWS_MARKET_DATA_API_KEY=your-aws-api-key
# AWS_REGION=us-east-1

# --- Rate Limiting (see app/rate_limit.py) ---
# All thresholds below are optional - each has a sensible built-in default and can be tuned
# per-deployment without a code change. Uncomment only the ones you want to override.
# Master switch - set to false to disable rate limiting entirely (e.g. for local dev/tests).
# RATE_LIMIT_ENABLED=true
# Trust the X-Forwarded-For header for per-IP limiting (only enable if this API sits behind
# a proxy/load balancer you control - otherwise the header can be spoofed to bypass limits).
# RATE_LIMIT_TRUST_PROXY=false
#
# AUTH tier - strict. Applies to failed Firebase ID token verification attempts (the closest
# thing this API has to a "login" boundary, since Firebase Auth sign-in/sign-up/password-reset
# run client-side against Google's own infrastructure, not through this backend).
# RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
# RATE_LIMIT_AUTH_WINDOW_SECONDS=300
# RATE_LIMIT_AUTH_BACKOFF_BASE_SECONDS=30
# RATE_LIMIT_AUTH_BACKOFF_MAX_SECONDS=3600
#
# PUBLIC tier - moderate. Applies to unauthenticated public endpoints (job listings, job
# market intelligence overview/companies/skills/trends).
# RATE_LIMIT_PUBLIC_MAX_ATTEMPTS=60
# RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
# RATE_LIMIT_PUBLIC_BACKOFF_BASE_SECONDS=10
# RATE_LIMIT_PUBLIC_BACKOFF_MAX_SECONDS=600
#
# USER tier - per-authenticated-account. Applies to sensitive actions by a logged-in user:
# profile updates, assessment/quiz submission, evidence upload, admin role changes.
# RATE_LIMIT_USER_MAX_ATTEMPTS=30
# RATE_LIMIT_USER_WINDOW_SECONDS=60
# RATE_LIMIT_USER_BACKOFF_BASE_SECONDS=15
# RATE_LIMIT_USER_BACKOFF_MAX_SECONDS=900
