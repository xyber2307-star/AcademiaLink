# AcademiaLINK Frontend Environment Configuration Template
# Duplicate this file to '.env' and fill in your actual credentials.

# API Base URL for backend communications
VITE_API_URL=http://localhost:8000/api

# Firebase Web App Configuration (from Firebase Console -> Project Settings -> General -> Your Apps)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=academialink-b10b3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=academialink-b10b3
VITE_FIREBASE_STORAGE_BUCKET=academialink-b10b3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
